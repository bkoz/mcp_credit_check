# Production Secrets Template
#
# INSTRUCTIONS:
# 1. Copy this file to secrets.yaml: cp secrets.yaml.template secrets.yaml
# 2. Replace the placeholder values below with your actual PRODUCTION credentials
# 3. DO NOT commit secrets.yaml to Git (it's in .gitignore)
#
# NOTE: secrets.yaml is required for deployment
#
# SECURITY WARNING:
# - Use different credentials for production than development
# - Never share production credentials
# - Consider using OpenShift Sealed Secrets or external secret management

---
apiVersion: v1
kind: Secret
metadata:
  name: equifax-credentials
type: Opaque
stringData:
  EQUIFAX_CLIENT_ID: "REPLACE_WITH_YOUR_PROD_EQUIFAX_CLIENT_ID"
  EQUIFAX_CLIENT_SECRET: "REPLACE_WITH_YOUR_PROD_EQUIFAX_CLIENT_SECRET"

---
apiVersion: v1
kind: Secret
metadata:
  name: github-token
type: Opaque
stringData:
  GITHUB_TOKEN: "REPLACE_WITH_YOUR_PROD_GITHUB_TOKEN"
